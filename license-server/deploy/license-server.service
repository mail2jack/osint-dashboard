[Unit]
Description=Iveras License & Telemetry Server
After=network.target

[Service]
User=license
Group=license
WorkingDirectory=/opt/license-server
Environment=HOME=/opt/license-server
Environment=LICENSE_ENV=production
EnvironmentFile=/opt/license-server/.env
ExecStart=/opt/license-server/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 --timeout 30 app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
