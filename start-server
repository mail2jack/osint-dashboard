#!/bin/bash
#
# start-server — Iveras OSINT Dashboard service manager
# Uses systemd services created by install.sh, runs as osint user.
#
# Usage:
#   ./start-server start      Start all services
#   ./start-server stop       Stop all services
#   ./start-server restart    Restart all services
#   ./start-server status     Show status
#   ./start-server logs       Live logs Iveras
#   ./start-server logs-sf    Live logs SpiderFoot
#   ./start-server update     Git pull + restart
#

set -e

SERVICE="osint-dashboard"
SF_SERVICE="spiderfoot"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

info()  { echo -e "${GREEN}[INFO]${NC} $1"; }
warn()  { echo -e "${YELLOW}[WARN]${NC} $1"; }
err()   { echo -e "${RED}[ERROR]${NC} $1"; }

check_root() {
    if [ "$EUID" -ne 0 ]; then
        err "This script must be run as root (or with sudo)."
        exit 1
    fi
}

cmd_start() {
    check_root
    info "Starting SpiderFoot..."
    systemctl start "$SF_SERVICE" 2>/dev/null || warn "SpiderFoot not installed"
    sleep 2
    info "Starting Iveras dashboard..."
    systemctl start "$SERVICE"
    sleep 2
    cmd_status
}

cmd_stop() {
    check_root
    info "Stopping all services..."
    systemctl stop "$SERVICE" 2>/dev/null || true
    systemctl stop "$SF_SERVICE" 2>/dev/null || true
    info "Stopped."
}

cmd_restart() {
    check_root
    cmd_stop
    sleep 2
    cmd_start
}

cmd_status() {
    echo "--- Iveras Dashboard ---"
    systemctl status "$SERVICE" --no-pager 2>/dev/null || echo "  (not installed)"
    echo ""
    echo "--- SpiderFoot ---"
    systemctl status "$SF_SERVICE" --no-pager 2>/dev/null || echo "  (not installed)"
    echo ""
    echo "--- Nginx ---"
    systemctl status nginx --no-pager 2>/dev/null | head -3
    echo ""
    echo "--- Fail2ban ---"
    systemctl status fail2ban --no-pager 2>/dev/null | head -3
    echo ""
    echo "--- Health Check ---"
    curl -s -o /dev/null -w "  Iveras: HTTP %{http_code}\n" http://127.0.0.1:5000/health 2>/dev/null || echo "  Iveras: UNREACHABLE"
    curl -s -o /dev/null -w "  SpiderFoot: HTTP %{http_code}\n" http://127.0.0.1:5001 2>/dev/null || echo "  SpiderFoot: UNREACHABLE"
}

cmd_logs() {
    journalctl -u "$SERVICE" -f --no-hostname -o cat
}

cmd_logs_sf() {
    journalctl -u "$SF_SERVICE" -f --no-hostname -o cat
}

cmd_update() {
    check_root
    info "Pulling code from GitHub..."
    cd /opt/osint-dashboard
    sudo -u osint git pull
    info "Updating Python packages..."
    sudo -u osint ./venv/bin/pip install -r requirements.txt -q
    info "Rebuilding frontend assets..."
    sudo -u osint env PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
        node build.mjs || warn "Frontend build failed — static assets may be stale"
    info "Running database migrations..."
    # Read DATABASE_URL from .env (sudo strips env vars)
    DB_URL=""
    if [ -f /opt/osint-dashboard/.env ]; then
        DB_URL=$(grep -m1 '^DATABASE_URL=' /opt/osint-dashboard/.env | cut -d= -f2- || true)
    fi
    sudo -u osint env DATABASE_URL="$DB_URL" ./venv/bin/python -m alembic upgrade head || warn "Alembic upgrade failed"
    info "Restarting..."
    cmd_stop
    sleep 2
    cmd_start
}

case "${1:-status}" in
    start)   cmd_start ;;
    stop)    cmd_stop ;;
    restart) cmd_restart ;;
    status)  cmd_status ;;
    logs)    cmd_logs ;;
    logs-sf) cmd_logs_sf ;;
    update)  cmd_update ;;
    *)
        echo "Usage: $0 {start|stop|restart|status|logs|logs-sf|update}"
        exit 1
        ;;
esac
