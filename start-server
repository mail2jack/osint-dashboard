#!/bin/bash
#
# start-server — Iveras OSINT Dashboard service manager
# Gebruikt systemd services (install.sh), draait als osint gebruiker.
#
# Usage:
#   ./start-server start      Start alle services
#   ./start-server stop       Stop alle services
#   ./start-server restart    Herstart alle services
#   ./start-server status     Toon status
#   ./start-server logs       Live logs Iveras
#   ./start-server logs-sf    Live logs SpiderFoot
#   ./start-server update     Git pull + herstart
#

set -e

SERVICE="osint-dashboard"
SF_SERVICE="spiderfoot"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

info()  { echo -e "${GREEN}[INFO]${NC} $1"; }
warn()  { echo -e "${YELLOW}[WARN]${NC} $1"; }
err()   { echo -e "${RED}[ERROR]${NC} $1"; }

check_root() {
    if [ "$EUID" -ne 0 ]; then
        err "Dit script moet als root (of sudo)."
        exit 1
    fi
}

cmd_start() {
    check_root
    info "SpiderFoot starten..."
    systemctl start "$SF_SERVICE" 2>/dev/null || warn "SpiderFoot niet geïnstalleerd"
    sleep 2
    info "Iveras dashboard starten..."
    systemctl start "$SERVICE"
    sleep 2
    cmd_status
}

cmd_stop() {
    check_root
    info "Alles stoppen..."
    systemctl stop "$SERVICE" 2>/dev/null || true
    systemctl stop "$SF_SERVICE" 2>/dev/null || true
    info "Gestopt."
}

cmd_restart() {
    check_root
    cmd_stop
    sleep 2
    cmd_start
}

cmd_status() {
    echo "--- Iveras Dashboard ---"
    systemctl status "$SERVICE" --no-pager 2>/dev/null || echo "  (niet geïnstalleerd)"
    echo ""
    echo "--- SpiderFoot ---"
    systemctl status "$SF_SERVICE" --no-pager 2>/dev/null || echo "  (niet geïnstalleerd)"
    echo ""
    echo "--- Nginx ---"
    systemctl status nginx --no-pager 2>/dev/null | head -3
    echo ""
    echo "--- Fail2ban ---"
    systemctl status fail2ban --no-pager 2>/dev/null | head -3
    echo ""
    echo "--- Health Check ---"
    curl -s -o /dev/null -w "  Iveras: HTTP %{http_code}\n" http://127.0.0.1:5000/health 2>/dev/null || echo "  Iveras: NIET BEREIKBAAR"
    curl -s -o /dev/null -w "  SpiderFoot: HTTP %{http_code}\n" http://127.0.0.1:5001 2>/dev/null || echo "  SpiderFoot: NIET BEREIKBAAR"
}

cmd_logs() {
    journalctl -u "$SERVICE" -f --no-hostname -o cat
}

cmd_logs_sf() {
    journalctl -u "$SF_SERVICE" -f --no-hostname -o cat
}

cmd_update() {
    check_root
    info "Code pullen van GitHub..."
    cd /opt/osint-dashboard
    sudo -u osint git pull
    info "Herstarten..."
    cmd_stop
    sleep 2
    cmd_start
}

case "${1:-status}" in
    start)   cmd_start ;;
    stop)    cmd_stop ;;
    restart) cmd_restart ;;
    status)  cmd_status ;;
    logs)    cmd_logs ;;
    logs-sf) cmd_logs_sf ;;
    update)  cmd_update ;;
    *)
        echo "Usage: $0 {start|stop|restart|status|logs|logs-sf|update}"
        exit 1
        ;;
esac
