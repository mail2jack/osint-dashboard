{
  "title": "Iveras OSINT Dashboard",
  "uid": "iveras-osint",
  "version": 1,
  "timezone": "browser",
  "schemaVersion": 39,
  "tags": ["iveras", "osint"],
  "refresh": "10s",
  "panels": [
    {
      "title": "Request Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "rate(http_requests_total[1m])",
          "legendFormat": "all",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {"showPoints": "never"}
        }
      }
    },
    {
      "title": "Active Requests",
      "type": "gauge",
      "gridPos": {"h": 8, "w": 4, "x": 8, "y": 0},
      "targets": [
        {
          "expr": "http_requests_active",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 50,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "green"},
              {"value": 10, "color": "yellow"},
              {"value": 30, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "title": "HTTP Status (2xx / 4xx / 5xx)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "rate(http_requests_by_status_total{status=\"200\"}[1m])",
          "legendFormat": "2xx",
          "refId": "A"
        },
        {
          "expr": "rate(http_requests_by_status_total{status=\"400\"}[1m])",
          "legendFormat": "4xx",
          "refId": "B"
        },
        {
          "expr": "rate(http_requests_by_status_total{status=\"500\"}[1m])",
          "legendFormat": "5xx",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {"showPoints": "never"},
          "min": 0
        }
      }
    },
    {
      "title": "Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(http_request_duration_ms_bucket[1m]))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_ms_bucket[1m]))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(http_request_duration_ms_bucket[1m]))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {"showPoints": "never"},
          "min": 0
        }
      }
    },
    {
      "title": "Top Routes",
      "type": "table",
      "gridPos": {"h": 8, "w": 8, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "topk(10, rate(http_requests_by_route_total[5m]))",
          "legendFormat": "__auto",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {"align": "auto"},
          "decimals": 2
        }
      },
      "transformations": [
        {"id": "extractFields", "options": {}},
        {"id": "sortBy", "options": {"sort": [{"field": "Value", "desc": true}]}}
      ]
    },
    {
      "title": "Request Duration Distribution",
      "type": "histogram",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "rate(http_request_duration_ms_bucket[1m])",
          "legendFormat": "{{le}}ms",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {"hideFrom": {"legend": false}},
          "min": 0
        }
      }
    },
    {
      "title": "Requests by Method",
      "type": "piechart",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16},
      "targets": [
        {
          "expr": "rate(http_requests_by_method_total[5m])",
          "legendFormat": "{{method}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2
        }
      },
      "options": {
        "displayLabels": ["name", "percent"],
        "legend": {"displayMode": "table", "placement": "right"},
        "reduceOptions": {"calcs": ["sum"]}
      }
    }
  ]
}
