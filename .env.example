# =============================================================================
# Iveras OSINT Dashboard - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- Environment ---
# Set to "production" on production server, "development" for local dev
FLASK_ENV=production

# --- Flask / App ---
FLASK_APP=app.py
SECRET_KEY=<generate with: openssl rand -hex 32>

# --- Database ---
# Default: SQLite (cms.db) — zero-config, perfect for local dev
# Optional: PostgreSQL (matches production) — set DATABASE_URL below
#   Setting up PostgreSQL on macOS:
#     brew install postgresql@16
#     brew services start postgresql@16
#     createdb cms_dev
#   If Postgres is unavailable, the app gracefully falls back to SQLite.
# DATABASE_URL=postgresql://$(whoami)@localhost:5432/cms_dev
# Production:
DATABASE_URL=postgresql://osint:<db-password>@localhost:5432/osint_db
# SSL mode for PostgreSQL: prefer (default), require (production), disable (dev)
DB_SSL_MODE=prefer

# --- Server ---
PORT=5000

# --- Uploads ---
# Directory for uploaded files. Defaults to static/uploads if not set.
UPLOAD_FOLDER=static/uploads

# --- CMS API Key ---
# Used for server-to-server API access (e.g., from worker scripts).
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
CMS_API_KEY=

# --- CMS Encryption (REQUIRED) ---
# Used for encrypting sensitive CMS data fields.
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CMS_ENCRYPTION_KEY=

# --- SpiderFoot OSINT Integration ---
# URL where SpiderFoot is running (default: localhost:5001)
SPIDERFOOT_URL=http://localhost:5001
# Digest auth credentials (auto-generated during install.sh)
SPIDERFOOT_USERNAME=admin
SPIDERFOOT_PASSWORD=<auto-generated>

# --- API Keys (Optional - leave blank to disable features) ---
# NOTE: API keys can be set via Settings > API Keys in the UI (recommended).
# .env fallback works but is not preferred — keys set via the UI are stored
# in the Setting table and can be changed without a server restart.
# Overheid.io API Key - https://overheid.io (free for non-commercial)
OVERHEID_API_KEY=
# Brave Search API Key - https://brave.com/search/api/ (2000 free queries/month)
BRAVE_API_KEY=
# 2Chat API Key - https://app.2chat.io
TWOCHAT_API_KEY=
TWOCHAT_WHATSAPP_NUMBER=
# WhatsApp Service (Baileys) — replaces 2Chat for WhatsApp checks.
# Only needed if running the Node.js service outside Docker.
# In Docker this is set automatically via docker-compose.yml.
# WA_SERVICE_URL=http://localhost:3001
# Have I Been Pwned API Key - https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# --- AI Provider ---
# OpenRouter (primary): 300+ models via unified API. Get key at https://openrouter.ai/keys
# Set via Settings > AI Provider instead of .env for production.
# OPENROUTER_API_KEY=
# Ollama (fallback): local LLM when OpenRouter is unavailable
# OLLAMA_URL=http://localhost:11434/api/generate
# OLLAMA_MODEL=llama3.2

# --- Stripe Billing ---
# Stripe API keys for SaaS subscription billing.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- CORS ---
# Comma-separated origins allowed for cross-origin requests (e.g. API calls from a frontend).
# Leave empty to allow all origins in development, set explicitly in production.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# --- Redis ---
# Redis URL for caching, session storage, and background task queues.
# Leave empty to fall back to in-memory/file-based storage.
# REDIS_URL=redis://localhost:6379/0

# --- Updates ---
# GitHub repo for update checks (e.g. "youruser/osint-dashboard").
# Leave empty to disable. Set via Settings page after first deploy.
UPDATE_CHECK_REPO=
