[Unit]
Description=Purge expired license-server IP intelligence and admin audit data
After=network.target

[Service]
Type=oneshot
User=license
Group=license
WorkingDirectory=/opt/license-server
EnvironmentFile=/opt/license-server/.env
ExecStart=/opt/license-server/venv/bin/python3 /opt/license-server/cli.py privacy:purge
NoNewPrivileges=true
ProtectSystem=strict
# ProtectSystem=strict makes the whole filesystem read-only; keep the sqlite DB
# writable or every purge run fails with "attempt to write a readonly database".
ReadWritePaths=/opt/license-server/data
