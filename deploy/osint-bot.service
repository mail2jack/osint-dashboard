[Unit]
Description=Iveras Telegram Bot
Documentation=https://github.com/anomalyco/osint-dashboard
After=network.target osint-dashboard.service
Requires=osint-dashboard.service

[Service]
Type=simple
User=osint
Group=osint
WorkingDirectory=/opt/osint-dashboard
Environment="PATH=/opt/osint-dashboard/venv/bin"
# Keep $HOME outside /home so ProtectHome=true can stay enabled — this also
# stops libpq from probing /home/osint/.postgresql for a client certificate.
Environment="HOME=/opt/osint-dashboard"
ExecStart=/opt/osint-dashboard/venv/bin/python3 /opt/osint-dashboard/scripts/run_bot.py
Restart=always
RestartSec=10s

# Security hardening
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
