[Unit]
Description=Alert after failed OSINT backup verification

[Service]
Type=oneshot
User=osint
Group=osint
SupplementaryGroups=postdrop
EnvironmentFile=-/etc/default/osint-dr
ExecStart=/opt/osint-dashboard/scripts/backup_verification_alert.sh
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/spool/postfix/maildrop
