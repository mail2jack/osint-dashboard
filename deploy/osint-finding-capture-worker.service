[Unit]
Description=OSINT finding screenshot capture worker (disabled foundation)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=osint
Group=osint
WorkingDirectory=/opt/osint-dashboard
# A future executor must be separately enabled after sandbox verification.
Environment=FINDING_CAPTURE_WORKER_ENABLED=0
ExecStart=/opt/osint-dashboard/venv/bin/python3 /opt/osint-dashboard/scripts/run_finding_capture_worker.py
TimeoutStartSec=90
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/osint-dashboard/instance /tmp
RestrictNamespaces=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
